# Public identifiers only. Leave both unset for repository-seed Preview mode.
# Configure only after the separately authorized Sanity setup.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Contact delivery through the owner's existing Resend account. Server-only.
# Recipient is fixed in code to jamesjoelowery@gmail.com.
# Use a sending-only key restricted to an approved verified sender domain.
RESEND_API_KEY=
# A bare sender address from that verified domain (not the visitor's email).
CONTACT_FROM_EMAIL=
