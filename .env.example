# Public identifiers only. Leave both unset for repository-seed Preview mode.
# Configure only after the separately authorized Sanity setup.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Contact delivery through the owner's existing Resend account. Server-only.
# Recipient is fixed in code to jamesjoelowery@gmail.com.
# Use a sending-only key restricted to an approved verified sender domain.
RESEND_API_KEY=
# A bare sender address from that verified domain (not the visitor's email).
CONTACT_FROM_EMAIL=

# Free Cloudflare Turnstile Managed widget. Site key is public; secret is server-only.
# Configure privately before deploying; missing configuration blocks contact sends.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact hostnames, comma-separated. Never derive these from a request header.
# Production: jjlowery.com,www.jjlowery.com. Use a separate exact hostname for Preview.
TURNSTILE_ALLOWED_HOSTNAMES=
